#once
[Meta]

#define GFX_BufferOffset 0

#define GFX_FORMAT_RGB32 0

#define cat_GFX 1

#define GFXSync 1
#define GFXPresent 2

#define GFX_MODE_DISABLED 0
#define GFX_MODE_PIXEL_BUFFER 1

struct GFXLayerConfig {
    configHigh: u16;
    configLow: u16;
    dataHigh: u16;
    dataLow: u16;
}

struct GFXColorRGB32 {
    r: u8;
    g: u8;
    b: u8;
    n: u8;
}

struct GFXHeader {
    enable: u8;
    screenWidth: u16;
    screenHeight: u16;
    screenScale: u8;
    clearColor: GFXColorRGB32;
    clearEnable: u8;
    layerReg: u16;
    layers: [16]GFXLayerConfig;
}



struct GFXPixelBufferConfig {
    mode: u8;
    width: u16;
    height: u16;
    format: u8;
}
