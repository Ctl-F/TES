#define cat_Sys 0
#define cat_GFX 1
#define cat_IO 2

#define SYSTEM 0
#define GRAPHICS 1
#define IO 2
#define TRACE 3

#define STOPWATCH 256
#define REPORT 512

; cat_Sys
#define SerialWrite 0
#define SerialPrintf 1

; cat_GFX
#define GFXSync 1
#define GFXPresent 2

; cat_IO
#define IOSync 1
#define IOPoll 2

#define MMIO_PAGE_ID 255
#define MMIO_HEADER_BASE 0
