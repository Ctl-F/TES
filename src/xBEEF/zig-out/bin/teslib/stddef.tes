; mov R2, Message_End;
; sub R2, R1;
; syscall cat_Sys, SerialWrite;
#define cat_Sys 0
#define cat_GFX 1
#define cat_IO 2

; cat_Sys
#define SerialWrite 0

; cat_GFX
#define GFXSync 1
#define GFXPresent 2

; cat_IO
#define IOSync 1
#define IOPoll 2

#define MMIO_PAGE_ID 255
#define MMIO_HEADER_BASE 0
