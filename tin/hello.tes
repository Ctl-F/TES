#include "stddef.tes"
[Data(0:0x0400)]
_cm_g_HelloMessage: "Hello World\n";
    ; todo: emit string or array
    ; todo: allow array initializer like this
    //.u8[13] .{ 72, 101, 108, 108, 111, 32, 87, 111, 114, 108, 100, 10, 0 }

[Data(0:0xF000)]
_StackHead: .u8[0x800] 0

[Program]
_start:
    mov ra, _StackHead;
    mov rb, 0x800;
    stackset ra, rb;
    // TODO: Implement stackset implicitly in _cm_main
_cm_main:
    push ra
    push rb
    lea ra, rb, _cm_g_HelloMessage
    mov r0, ra
    mov r1, rb
    mov r2, 13
    syscall $cat_Sys , $SerialWrite ;
_cm_L_0:
    pop rb
    pop ra
    b jr
