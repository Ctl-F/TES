#include "stddef.tes"

#define STACK_SIZE 0x800

#define WINDOW_WIDTH 240
#define WINDOW_HEIGHT 120
#define BYTES_PER_PIXEL 2

[Data(0:0x0400)]
defaultClearColor: .ColorRGB32 .{ 25, 25, 45, 255 }
layerConfigInst: .GPUPixelLayerConfig .{ $STRUCT_LAYER_CONFIG_FRAMEBUFFER, $PIXEL_FORMAT_RGB565, $WINDOW_WIDTH, $WINDOW_HEIGHT }

[Data(0:0xF000)]
_StackHead: .u8[$STACK_SIZE] 0

[Data(1:0x0000)]
_PixelBuffer: .u8[${ WINDOW_WIDTH * WINDOW_HEIGHT * 2 }] 0


[Program]
_start:
    mov ra, _StackHead;
    mov rb, $STACK_SIZE;
    stackset ra, rb;

    bn _init_gpu;

@{
    @bind current_frame: r1; // Tracks the animation step
    @bind screen_limit:  r2;
    @bind pixel_idx:     r3;
    @bind x_coord:       r4;
    @bind condition:     r5;

    @bind bar_color:     r6;
    @bind bg_color:      r7;

    @bind accum:         r8;
    @bind imm:           r9;

    xor current_frame, current_frame;
    mov screen_limit, ${ WINDOW_WIDTH * WINDOW_HEIGHT };
    mov bg_color, 0x1111;

loop:
    mov bar_color, 0xFFFF;

    xor pixel_idx, pixel_idx;
    xor x_coord, x_coord;
    lea ra, rb, _PixelBuffer;

_fill:
    seteq condition, x_coord, current_frame;
    bnt condition, _draw_bar;

_draw_bg:
    movi [ra, rb], bg_color;
    bn _next_pixel;

_draw_bar:
    movi [ra, rb], bar_color;

_next_pixel:
    inc pixel_idx;
    inc x_coord;

    mov imm, $WINDOW_WIDTH;
    xor accum, accum;
    setge condition, x_coord, imm;
    select x_coord, accum, x_coord, condition;


    setge condition, pixel_idx, screen_limit;
    bnf condition, _fill;

_end_fill:
    inc current_frame;

    // wrap bar around
    mov imm, $WINDOW_WIDTH;
    setge condition, current_frame, imm;
    bnf condition, _vsync;
    xor current_frame, current_frame;
}

_vsync:
    yield;
; check if window should close
_check_input:
    mov re, $MMIO_PAGE_ID;
    mov rf, $MMIO_HEADER_BASE;
    mov r0, $offsetOf(MemIOMap, io);
    add rf, r0;
    mov ra, (byte)[re, (IOHeader.closeSignal)rf];
    bnf ra, loop;

_end:
    hlt;

@{
    @bind page : re;
    @bind ptr : rf;
    @bind val : rd;
    @bind valPtrPage : rc;
    @bind valPtr : rb;
    @bind val2 : ra;

_init_gpu:
    push jr;

    mov page, $MMIO_PAGE_ID;
    mov ptr, $MMIO_HEADER_BASE;
    mov val, $offsetOf(MemIOMap, gpu);
    add ptr, val;

    ; initialize gpu
    mov val, $true;
    mov (byte) [page, (GPUHeader.enable)ptr], val;

    ; save an instruction and write true to clear color also
    mov (byte) [page, (GPUHeader.clearEnable)ptr], val;

    ; configure screen
    mov val, 4;
    mov (byte) [page, (GPUHeader.screenScale)ptr], val;

    mov val, $WINDOW_WIDTH;
    mov [page, (GPUHeader.screenWidth)ptr], val;

    mov val, $WINDOW_HEIGHT;
    mov [page, (GPUHeader.screenHeight)ptr], val;


    ; configure clear color
    lea valPtrPage, valPtr, defaultClearColor;
    mov val2, $offsetOf(GPUHeader, clearColor);
    add ptr, val2;
    mov val, $sizeOf(ColorRGB32);

    mcpy page, ptr, valPtrPage, valPtr, val;

    sub ptr, val2;

    ; enable only 0
    mov val, 0x0001;
    mov [page, (GPUHeader.layerEnable)ptr], val;

    ; set the layer config data in the gpu header
    mov val2, $offsetOf(GPUHeader, layers);
    add ptr, val2;

    lea valPtrPage, valPtr, layerConfigInst;
    mov [page, (GPULayerConfig.configHigh)ptr], valPtrPage;
    mov [page, (GPULayerConfig.configLow)ptr], valPtr;

    lea valPtrPage, valPtr, _PixelBuffer;
    mov [page, (GPULayerConfig.dataHigh)ptr], valPtrPage;
    mov [page, (GPULayerConfig.dataLow)ptr], valPtr;


    ; push the config to the gpu
    syscall $cat_GFX, $GFXSync;

    pop jr;
    b jr;
}
