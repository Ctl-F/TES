// Snake clone
#include "stddef.tes"
[Meta]

#define STACK_SIZE 0x1FFE

#define BOARD_WIDTH 48
#define BOARD_HEIGHT 48
#define BOARD_SCALE 10

#define FOOD_COLOR 0b01111100000000000
#define SNAKE_COLOR 0b0000001111100000

#define MAX_SNAKE_SIZE 1024
#define MAX_FOOD_SIZE 4

enum Dir {
    North = 0;
    East;
    South;
    West;
}

struct Point {
    y: u8;
    x: u8;
}

struct Snake {
    direction: u16;
    head: Point;
    bodyCount: u16;
    body: [$MAX_SNAKE_SIZE]Point;
}

struct Food {
    count: u16;
    food: [$MAX_FOOD_SIZE]Point;
}

[Data(0:0xE000)]
_StackHead: .u8[$STACK_SIZE] 0

[Data(0:0x400)]
_ClearColor: .ColorRGB32 .{ 10, 10, 10, 255 }
_FrameBufferConfig: .GPUPixelLayerConfig .{ $STRUCT_LAYER_CONFIG_FRAMEBUFFER, $PIXEL_FORMAT_RGBA5551, $BOARD_WIDTH, $BOARD_HEIGHT }
_InputBuffer: .IOBufferControllerSource 0

[Data(0:0x500)]
_snake: .Snake 0
_food: .Food 0

[Data(1:0x0000)]
_FrameBuffer: .u16[${BOARD_WIDTH * BOARD_HEIGHT}] 0xFFFF //0b1111100000000001

[Data(2:0x0000)]
_GameBuffer: .u16[${BOARD_WIDTH * BOARD_HEIGHT}] 0

[Program]
_start:
    // initialize the stack
    mov ra, _StackHead;
    mov rb, $STACK_SIZE;
    stackset ra, rb;
_main: @{
    // initialize hardware
    bn _init_gpu;
    bn _init_io;

    ;bn _draw_gradient;
@loop:
    yield;
    mov ra, $MMIO_PAGE_ID;
    mov rb, $MMIO_HEADER_BASE;
    mov rc, (byte)[ra, (MemIOMap.io.closeSignal)rb];
    bnf rc, @loop;
}
_end:
    hlt;

