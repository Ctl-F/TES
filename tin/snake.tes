_draw_gradient: @{
    @const start : 10;
    @const step : 15;
    @const iterations : 8;

    @bind cursor: r7;
    @bind colorCounter : rd;
    @bind tmp : re;
    @bind edge : r8;
    @bind condition : rf;
    @bind bufferStart : r9;
    @bind rowWritePtr : rc;  ; Dedicated pointer for the auto-incrementing write

    push jr;
    push rb, rc;
    push re, rf;
    push ra, rd;
    push r9, r7;
    push r8;

    ; Grab the framebuffer base pointers (Page 1)
    lea ra, rb, _FrameBuffer;

    ; Safely reserve space on the stack for our temporary row buffer
    bump ${ -(BOARD_WIDTH * 2) };
    mov bufferStart, sp;

    xor cursor, cursor;
    mov colorCounter, @start;

@fillLoop:
    mov tmp, @iterations;
    setge condition, cursor, tmp;
    bnt condition, @endFillLoop;     ; Branch Near if True (Exit loop when cursor >= 8)

    // Build the RGB565 color for this iteration
    mov r0, colorCounter;
    mov r1, colorCounter;
    mov r2, colorCounter;
    bn _make_color;

    mov tmp, @step;
    add colorCounter, tmp;

    // Set up bounds to fill the row scratchpad
    mov rowWritePtr, bufferStart;    ; Use a dedicated register so we don't mutate cursor
    mov edge, ${ BOARD_WIDTH * 2 };
    add edge, bufferStart;          ; edge = end address of our stack row buffer
    xor tmp, tmp;                   ; Page 0 selector for memory operations

@fillRow:
    movi [tmp, rowWritePtr], r0;     ; movi auto-increments rowWritePtr by 2
    setlt condition, rowWritePtr, edge;
    bnt condition, @fillRow;        ; Keep writing until rowWritePtr >= edge
@endFillRow:

    ; Get the raw width in bytes for the blit operation
    mov edge, ${ BOARD_WIDTH * 2 };

    // Blit the completed row 8 times sequentially down into the FrameBuffer
    @repeat(8, i){
        mcpy ra, rb, tmp, bufferStart, edge;
        add rb, edge;               ; Advance the framebuffer pointer by one row width
    }

    inc cursor;
    bn @fillLoop;                   ; Unconditional branch back to the top
@endFillLoop:

    ; Free the temporary row buffer space from the stack
    bump ${ (BOARD_WIDTH * 2) };

    pop r8;
    pop r9, r7;
    pop ra, rd;
    pop re, rf;
    pop rb, rc;
    pop jr;
    b jr;
}


// make_color(r: reg0, g: reg1, b: reg2) --> reg0
// takes r, g, b and packs into RGBA5551
@{
    @const MASK_5 : 0b11111;
    @const SHIFT_R : 11;
    @const SHIFT_G : 6;
    @const SHIFT_B : 1;      ; Blue only needs to step left by 1 bit to clear Alpha (bit 0)

    @bind result : r0;     ; Input Red / Output Packed Color
    @bind color : rc;
    @bind green : r1;      ; Input Green
    @bind blue : r2;       ; Input Blue

    @bind temp : ra;

_make_color:
    push jr;
    push ra;

    ; --- 1. Position Red (Bits 15-11) ---
    mov temp, @MASK_5;
    and result, temp;
    mov temp, @SHIFT_R;
    shl result, temp;

    ; --- 2. Position Green (Bits 10-6) ---
    mov temp, @MASK_5;
    and green, temp;
    mov temp, @SHIFT_G;
    shl green, temp;
    or result, green;      ; Safely merge Green

    ; --- 3. Position Blue (Bits 5-1) ---
    mov temp, @MASK_5;
    and blue, temp;
    mov temp, @SHIFT_B;    ; Shift blue independently by 1
    shl blue, temp;        ; Now blue sits at bits 5-1 safely
    or result, blue;       ; Safely merge Blue (leaves bit 0 as 0)

    ; --- 4. Set Opaque Alpha Flag (Bit 0) ---
    mov temp, 1;
    or result, temp;       ; Result layout is now perfectly: RRRRRGGGGGBBBBBA

    pop ra;
    pop jr;
    b jr;
}

; initialize gpu
_init_gpu:
    push jr;

    ; load header address
    mov ra, $MMIO_PAGE_ID;
    mov rb, $MMIO_HEADER_BASE;

    ; future-proof things. Technically this offset is zero
    ; in the current version and we could safely use rb
    ; with no modification. But if the field order ever changes
    ; this should ensure that our code doesn't break
    mov rc, $offsetOf(MemIOMap, gpu);
    add rb, rc;

    ; rb now holds the valid offset pointing to the gpu header

    ; enable gpu
    mov r0, $true;
    mov (byte) [ra, (GPUHeader.enable)rb], r0;

    ; enable clear
    mov (byte)[ra, (GPUHeader.clearEnable)rb], r0;

    ; set clear color
    lea rc, rd, _ClearColor;
    mov rf, $offsetOf(GPUHeader, clearColor);
    add rb, rf;
    mov re, $sizeOf(ColorRGB32);

    mcpy ra, rb, rc, rd, re;

    sub rb, rf;

    ; set resolution
    mov rc, $BOARD_WIDTH;
    mov [ra, (GPUHeader.screenWidth)rb], rc;

    mov rc, $BOARD_HEIGHT;
    mov [ra, (GPUHeader.screenHeight)rb], rc;

    mov rc, $BOARD_SCALE;
    mov [ra, (GPUHeader.screenScale)rb], (byte)rc;

    ; enable layers
    mov rc, 0x0001;
    mov [ra, (GPUHeader.layerEnable)rb], rc;

    mov rc, $offsetOf(GPUHeader, layers);
    add rb, rc;

    lea rc, rd, _FrameBufferConfig;
    mov [ra, (GPULayerConfig.configHigh)rb], rc;
    mov [ra, (GPULayerConfig.configLow)rb], rd;

    lea rc, rd, _FrameBuffer;
    mov [ra, (GPULayerConfig.dataHigh)rb], rc;
    mov [ra, (GPULayerConfig.dataLow)rb], rc;

    syscall $GRAPHICS, $GFXSync;

    pop jr;
    b jr;

_init_io:
    push jr;

    mov ra, $MMIO_PAGE_ID;
    mov rb, $MMIO_HEADER_BASE;

    mov rc, $offsetOf(MemIOMap, io);
    add rb, rc;

    mov rc, $offsetOf(IOHeader, sources);
    add rb, rc;

    mov rc, $IO_SOURCE_CONTROLLER_0
    mov [ra, (IOSource.source)rb], (byte)rc;

    lea rc, rd, _InputBuffer;
    mov [ra, (IOSource.bufferHigh)rb], rc;
    mov [ra, (IOSource.bufferLow)rb], rd;

    syscall $IO, $IOSync;

    pop jr;
    b jr;
