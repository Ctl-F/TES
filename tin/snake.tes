// Snake clone
#include "stddef.tes"
[Meta]

#define STACK_SIZE 0x1FFE

#define BOARD_WIDTH 48
#define BOARD_HEIGHT 48
#define BOARD_SCALE 10

#define FOOD_COLOR 0b01111100000000000
#define SNAKE_COLOR 0b0000001111100000

#define MAX_SNAKE_SIZE 1024
#define MAX_FOOD_SIZE 4

enum Dir {
    North = 0;
    East;
    South;
    West;
}

struct Point {
    y: u8;
    x: u8;
}

struct Snake {
    direction: u16;
    head: Point;
    bodyCount: u16;
    body: [$MAX_SNAKE_SIZE]Point;
}

struct Food {
    count: u16;
    food: [$MAX_FOOD_SIZE]Point;
}

[Data(0:0xE000)]
_StackHead: .u8[$STACK_SIZE] 0

[Data(0:0x400)]
_ClearColor: .ColorRGB32 .{ 10, 10, 10, 255 }
_FrameBufferConfig: .GPUPixelLayerConfig .{ $STRUCT_LAYER_CONFIG_FRAMEBUFFER, $PIXEL_FORMAT_RGBA5551, $BOARD_WIDTH, $BOARD_HEIGHT }
_InputBuffer: .IOBufferControllerSource 0

[Data(0:0x500)]
_snake: .Snake 0
_food: .Food 0

[Data(1:0x0000)]
_FrameBuffer: .u16[${BOARD_WIDTH * BOARD_HEIGHT}] 0xFFFF //0b1111100000000001

[Data(2:0x0000)]
_GameBuffer: .u16[${BOARD_WIDTH * BOARD_HEIGHT}] 0

[Program]
_start:
    // initialize the stack
    mov ra, _StackHead;
    mov rb, $STACK_SIZE;
    stackset ra, rb;
_main: @{
    // initialize hardware
    bn _init_gpu;
    bn _init_io;
    // bn _draw_gradient;
    lea r0, r1, _FrameBuffer;
    mov r2, ${ BOARD_WIDTH * 2 };
    mov r3, 0b0111100000111111;
    bn _fillHLine;

@loop:
    yield;

    trap;

    mov ra, $MMIO_PAGE_ID;
    mov rb, $MMIO_HEADER_BASE;
    mov rc, (byte)[ra, (MemIOMap.io.closeSignal)rb];
    bnf rc, @loop;
}
_end:
    hlt;



// fillHLine(dst_psr: r0, dst_por: r1, len: r2, color: r3) void
_fillHLine: @{
    @bind page : r0;
    @bind start : r1;
    @bind end : r2; // inputed as length
    @bind color : r3;
    @bind cond : rf;

    push jr;
    push cond;

    // convert end from a relative length to an absolute address
    add end, start;

    syscall $TRACE, ${STOPWATCH + 0}

@hLoop:
    movi [page, start], color;
    setlt cond, start, end;
    bnt cond, @hLoop;

    syscall $TRACE, ${STOPWATCH + 0}
    syscall $TRACE, $REPORT


    pop cond;
    pop jr;
    b jr;
}

// make_color(r: reg0, g: reg1, b: reg2) --> reg0
// takes r, g, b and packs into RGBA5551
@{
    @const MASK_5 : 0b11111;
    @const SHIFT_R : 11;
    @const SHIFT_G : 6;
    @const SHIFT_B : 1;      ; Blue only needs to step left by 1 bit to clear Alpha (bit 0)

    @bind result : r0;     ; Input Red / Output Packed Color
    @bind color : rc;
    @bind green : r1;      ; Input Green
    @bind blue : r2;       ; Input Blue

    @bind temp : ra;

_make_color:
    push jr;
    push ra;

    ; --- 1. Position Red (Bits 15-11) ---
    mov temp, @MASK_5;
    and result, temp;
    mov temp, @SHIFT_R;
    shl result, temp;

    ; --- 2. Position Green (Bits 10-6) ---
    mov temp, @MASK_5;
    and green, temp;
    mov temp, @SHIFT_G;
    shl green, temp;
    or result, green;      ; Safely merge Green

    ; --- 3. Position Blue (Bits 5-1) ---
    mov temp, @MASK_5;
    and blue, temp;
    mov temp, @SHIFT_B;    ; Shift blue independently by 1
    shl blue, temp;        ; Now blue sits at bits 5-1 safely
    or result, blue;       ; Safely merge Blue (leaves bit 0 as 0)

    ; --- 4. Set Opaque Alpha Flag (Bit 0) ---
    mov temp, 1;
    or result, temp;       ; Result layout is now perfectly: RRRRRGGGGGBBBBBA

    pop ra;
    pop jr;
    b jr;
}

; initialize gpu
_init_gpu:
    push jr;

    ; load header address
    mov ra, $MMIO_PAGE_ID;
    mov rb, $MMIO_HEADER_BASE;

    ; future-proof things. Technically this offset is zero
    ; in the current version and we could safely use rb
    ; with no modification. But if the field order ever changes
    ; this should ensure that our code doesn't break
    mov rc, $offsetOf(MemIOMap, gpu);
    add rb, rc;

    ; rb now holds the valid offset pointing to the gpu header

    ; enable gpu
    mov r0, $true;
    mov (byte) [ra, (GPUHeader.enable)rb], r0;

    ; enable clear
    mov (byte)[ra, (GPUHeader.clearEnable)rb], r0;

    ; set clear color
    lea rc, rd, _ClearColor;
    mov rf, $offsetOf(GPUHeader, clearColor);
    add rb, rf;
    mov re, $sizeOf(ColorRGB32);

    mcpy ra, rb, rc, rd, re;

    sub rb, rf;

    ; set resolution
    mov rc, $BOARD_WIDTH;
    mov [ra, (GPUHeader.screenWidth)rb], rc;

    mov rc, $BOARD_HEIGHT;
    mov [ra, (GPUHeader.screenHeight)rb], rc;

    mov rc, $BOARD_SCALE;
    mov [ra, (GPUHeader.screenScale)rb], (byte)rc;

    ; enable layers
    mov rc, 0x0001;
    mov [ra, (GPUHeader.layerEnable)rb], rc;

    mov rc, $offsetOf(GPUHeader, layers);
    add rb, rc;

    lea rc, rd, _FrameBufferConfig;
    mov [ra, (GPULayerConfig.configHigh)rb], rc;
    mov [ra, (GPULayerConfig.configLow)rb], rd;

    lea rc, rd, _FrameBuffer;
    mov [ra, (GPULayerConfig.dataHigh)rb], rc;
    mov [ra, (GPULayerConfig.dataLow)rb], rc;

    syscall $GRAPHICS, $GFXSync;

    pop jr;
    b jr;

_init_io:
    push jr;

    mov ra, $MMIO_PAGE_ID;
    mov rb, $MMIO_HEADER_BASE;

    mov rc, $offsetOf(MemIOMap, io);
    add rb, rc;

    mov rc, $offsetOf(IOHeader, sources);
    add rb, rc;

    mov rc, $IO_SOURCE_CONTROLLER_0
    mov [ra, (IOSource.source)rb], (byte)rc;

    lea rc, rd, _InputBuffer;
    mov [ra, (IOSource.bufferHigh)rb], rc;
    mov [ra, (IOSource.bufferLow)rb], rd;

    syscall $IO, $IOSync;

    pop jr;
    b jr;
