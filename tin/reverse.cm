}

[*]u8 Secret = "0123456789";
[Secret.len]u8 Buffer = 0;

fn main() void {
    (u8 sP, u16 sO) = &Secret;
    (u8 dP, u16 dO) = &Buffer;

    reverse(sP, sO, dP, dO);
    print(dP, dO, Secret.len);
}

